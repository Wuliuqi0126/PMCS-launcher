{
  "name": "ol-launcher",
  "version": "1.4.7",
  "description": "OL启动器 - 我的世界 Java 版启动器，支持官方版本、局域网联机、Fabric/Forge 与 Modrinth 模组",
  "main": "main/index.js",
  "author": "OL Launcher",
  "license": "MIT",
  "scripts": {
    "start": "npm run build:renderer && electron .",
    "dev": "npm run build:renderer && electron . --dev",
    "shot": "npm run build:renderer && electron . --screenshot",
    "dist": "npm run build:renderer && electron-builder --win nsis",
    "dist:dir": "npm run build:renderer && electron-builder --win dir",
    "test:ui": "node scripts/ui-mock-test.js",
    "build:renderer": "node scripts/build-renderer.js"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.16.0"
  },
  "build": {
    "appId": "com.ol.launcher",
    "productName": "OL我的世界启动器",
    "asar": true,
    "asarUnpack": [
      "assets/tailscale/**",
      "assets/playit/**"
    ],
    "compression": "normal",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "assets/**/*",
      "preload.js",
      "package.json",
      "README.md",
      "LICENSE"
    ],
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "OLLauncher-${version}-Setup.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OL我的世界启动器",
      "uninstallDisplayName": "OL我的世界启动器 1.4.7",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "installerSidebar": "assets/installer-sidebar.bmp",
      "uninstallerSidebar": "assets/installer-sidebar.bmp",
      "installerLanguages": [
        "zh_CN"
      ],
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "OLLauncher-${version}-Setup.${ext}"
    }
  }
}
