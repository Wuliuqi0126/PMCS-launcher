'use strict';

const fs = require('fs');
const path = require('path');
const { fetchJson, downloadFile } = require('./http');
const { ensureDir, readJson, writeJson, exists, fileSize, sanitizeFileName } = require('./util');

const API = 'https://api.modrinth.com/v2';
const MANIFEST = '.oasis-mods.json';

function loaderCategory(loader) {
  if (loader === 'fabric') return 'fabric';
  if (loader === 'forge') return 'forge';
  if (loader === 'neoforge') return 'neoforge';
  return null;
}

function createMods({ store, tasks }) {
  const searchCache = new Map();

  function ensureInstance(instanceId) {
    const instance = store.getInstance(instanceId);
    if (!instance) throw new Error('请选择要安装模组的实例');
    if (instance.loader === 'vanilla') throw new Error('原版实例无法加载 Mod，请先创建一个 Fabric 或 Forge 实例');
    return instance;
  }

  function modsDir(instance) {
    const dir = path.join(store.instanceDir(instance), 'mods');
    ensureDir(dir);
    return dir;
  }

  function readManifest(instance) {
    return readJson(path.join(modsDir(instance), MANIFEST), { version: 1, mods: {} }) || { version: 1, mods: {} };
  }

  function saveManifest(instance, data) {
    writeJson(path.join(modsDir(instance), MANIFEST), data);
  }

  async function search(instanceId, options = {}) {
    const instance = store.getInstance(instanceId);
    if (!instance) return { hits: [], total: 0, offset: 0, limit: 20 };
    const loader = loaderCategory(instance.loader);
    const query = String(options.query || '').trim();
    const offset = Math.max(0, Number(options.offset) || 0);
    const limit = Math.max(1, Math.min(24, Number(options.limit) || 12));
    const sort = ['relevance', 'downloads', 'follows', 'newest', 'updated'].includes(options.sort) ? options.sort : 'relevance';
    const facets = [['project_type:mod']];
    if (instance.versionId) facets.push([`versions:${instance.versionId}`]);
    if (loader) facets.push([`categories:${loader}`]);
    const key = JSON.stringify({ instanceId, query, offset, limit, sort, loader, version: instance.versionId });
    const cached = searchCache.get(key);
    if (cached && Date.now() - cached.at < 60 * 1000) return cached.data;
    const url = `${API}/search?query=${encodeURIComponent(query)}&facets=${encodeURIComponent(JSON.stringify(facets))}&index=${sort}&offset=${offset}&limit=${limit}`;
    const data = await fetchJson(url, { timeout: 30000, retries: 2 });
    const result = {
      total: data.total_hits || 0,
      offset: data.offset || offset,
      limit: data.limit || limit,
      hits: (data.hits || []).map((hit) => ({
        projectId: hit.project_id,
        slug: hit.slug,
        title: hit.title,
        description: hit.description,
        author: hit.author,
        downloads: hit.downloads,
        follows: hit.follows,
        iconUrl: hit.icon_url,
        categories: hit.display_categories || hit.categories || [],
        versions: hit.versions || [],
        dateModified: hit.date_modified,
        color: hit.color,
      })),
    };
    searchCache.set(key, { at: Date.now(), data: result });
    if (searchCache.size > 60) searchCache.delete(searchCache.keys().next().value);
    return result;
  }

  async function fetchCompatibleVersion(projectId, instance) {
    const loader = loaderCategory(instance.loader);
    const facets = [];
    if (instance.versionId) facets.push(`game_versions=${encodeURIComponent(JSON.stringify([instance.versionId]))}`);
    if (loader) facets.push(`loaders=${encodeURIComponent(JSON.stringify([loader]))}`);
    const url = `${API}/project/${encodeURIComponent(projectId)}/version?${facets.join('&')}`;
    const versions = await fetchJson(url, { timeout: 30000, retries: 2 });
    if (!Array.isArray(versions) || !versions.length) {
      throw new Error(`该模组没有适用于 ${instance.versionId} / ${instance.loader} 的版本`);
    }
    return versions[0];
  }

  async function fetchVersionById(versionId) {
    return fetchJson(`${API}/version/${encodeURIComponent(versionId)}`, { timeout: 30000, retries: 2 });
  }

  async function projectInfo(projectId) {
    try {
      return await fetchJson(`${API}/project/${encodeURIComponent(projectId)}`, { timeout: 20000, retries: 1 });
    } catch (_) {
      return null;
    }
  }

  async function downloadModVersion(instance, version, manifest, depth = 0, visited = new Set()) {
    if (depth > 5) return [];
    const projectId = version.project_id;
    if (!projectId || visited.has(projectId)) return [];
    visited.add(projectId);
    const file = (version.files || []).find((item) => item.primary) || version.files?.[0];
    if (!file?.url || !file.filename) throw new Error('模组文件信息缺失');
    const dir = modsDir(instance);
    const filename = sanitizeFileName(file.filename, `${projectId}.jar`);
    const destination = path.join(dir, filename);
    await downloadFile(file.url, destination, {
      sha1: file.hashes?.sha1,
      size: file.size,
      timeout: 120000,
      retries: 2,
    });
    const info = await projectInfo(projectId);
    manifest.mods[filename] = {
      projectId,
      title: info?.title || version.name || projectId,
      versionId: version.id,
      versionNumber: version.version_number || '',
      iconUrl: info?.icon_url || '',
      author: info?.author || '',
      installedAt: new Date().toISOString(),
      enabled: true,
    };
    saveManifest(instance, manifest);
    const installed = [manifest.mods[filename]];
    for (const dependency of version.dependencies || []) {
      if (dependency.dependency_type !== 'required') continue;
      if (!dependency.project_id) continue;
      if (visited.has(dependency.project_id)) continue;
      let depVersion = null;
      if (dependency.version_id) {
        try { depVersion = await fetchVersionById(dependency.version_id); } catch (_) { depVersion = null; }
      }
      if (!depVersion) {
        try { depVersion = await fetchCompatibleVersion(dependency.project_id, instance); } catch (_) { depVersion = null; }
      }
      if (!depVersion) continue;
      const nested = await downloadModVersion(instance, depVersion, manifest, depth + 1, visited);
      installed.push(...nested);
    }
    return installed;
  }

  async function install(instanceId, projectId) {
    const instance = ensureInstance(instanceId);
    const task = tasks.start({
      title: '安装模组',
      kind: 'mod',
      meta: { instanceId, projectId },
    });
    try {
      task.update({ stage: '查找兼容版本', percent: 5, detail: `${instance.versionId} · ${instance.loader}` });
      const version = await fetchCompatibleVersion(projectId, instance);
      const manifest = readManifest(instance);
      task.update({ stage: '下载模组文件', percent: 20, detail: version.version_number || version.name || '' });
      const installed = await downloadModVersion(instance, version, manifest);
      task.done({ stage: '安装完成', detail: `${installed.length} 个模组` });
      return { ok: true, installed: await listInstalled(instanceId) };
    } catch (err) {
      task.fail(err);
      throw err;
    }
  }

  async function listInstalled(instanceId) {
    const instance = store.getInstance(instanceId);
    if (!instance) return [];
    const dir = modsDir(instance);
    const manifest = readManifest(instance);
    let files = [];
    try { files = fs.readdirSync(dir); } catch (_) { /* empty */ }
    const mods = [];
    for (const filename of files) {
      if (!/\.jar(\.disabled)?$/i.test(filename)) continue;
      const full = path.join(dir, filename);
      const enabled = !filename.endsWith('.disabled');
      let meta = manifest.mods[filename];
      if (!meta && enabled) {
        const disabledName = `${filename}.disabled`;
        meta = manifest.mods[disabledName];
      }
      mods.push({
        filename,
        enabled,
        size: fileSize(full),
        title: meta?.title || filename.replace(/\.jar(\.disabled)?$/i, ''),
        versionNumber: meta?.versionNumber || '',
        projectId: meta?.projectId || '',
        iconUrl: meta?.iconUrl || '',
        author: meta?.author || '',
        installedAt: meta?.installedAt || null,
      });
    }
    mods.sort((a, b) => {
      if (a.enabled !== b.enabled) return a.enabled ? -1 : 1;
      return a.title.localeCompare(b.title, 'zh-CN');
    });
    return mods;
  }

  async function setEnabled(instanceId, filename, enabled) {
    const instance = store.getInstance(instanceId);
    if (!instance) throw new Error('实例不存在');
    const dir = modsDir(instance);
    const safe = path.basename(String(filename));
    if (safe !== filename || !/\.jar(\.disabled)?$/i.test(safe)) throw new Error('无效的模组文件名');
    const source = path.join(dir, safe);
    if (!exists(source)) throw new Error('模组文件不存在');
    const targetName = enabled ? safe.replace(/\.disabled$/i, '') : (safe.endsWith('.disabled') ? safe : `${safe}.disabled`);
    const target = path.join(dir, targetName);
    if (target !== source) fs.renameSync(source, target);
    const manifest = readManifest(instance);
    const meta = manifest.mods[safe];
    if (meta) {
      delete manifest.mods[safe];
      meta.enabled = enabled;
      manifest.mods[targetName] = meta;
      saveManifest(instance, manifest);
    }
    return listInstalled(instanceId);
  }

  async function remove(instanceId, filename) {
    const instance = store.getInstance(instanceId);
    if (!instance) throw new Error('实例不存在');
    const dir = modsDir(instance);
    const safe = path.basename(String(filename));
    if (safe !== filename) throw new Error('无效的模组文件名');
    const full = path.join(dir, safe);
    if (exists(full)) fs.unlinkSync(full);
    const manifest = readManifest(instance);
    delete manifest.mods[safe];
    saveManifest(instance, manifest);
    return listInstalled(instanceId);
  }

  return {
    search,
    install,
    listInstalled,
    setEnabled,
    remove,
  };
}

module.exports = { createMods, loaderCategory };
